  "dependencies": {
    "@radix-ui/react-dialog": "1.1.15",
    "lucide-react": "0.468.0",
    "monaco-editor": "0.57.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "typescript": "5.7.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
